        <mxCell id="6S870EO1x6cLyfISw6w4-40" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Agent MUST write incremental Notion comment at each major checkpoint, not only at session end. Comment is the external memory, not the agent&#39;s context." vertex="1">
